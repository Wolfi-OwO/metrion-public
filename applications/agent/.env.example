# Azure Blob Storage - the container-scoped SAS token, NOT the account key.
# Permissions must be exactly "ac" (add+create) on the container - see
# docs/adr/0001-append-blob-over-table-storage.md and the delivery report's
# "Secrets" section for why.
AZURE_STORAGE_ACCOUNT=<storage-account-name>
AZURE_CONTAINER=vps-metrics
AZURE_SAS_TOKEN=sv=...&ss=...&srt=...&sp=ac&se=...&spr=https&sig=...
AZURE_SEND_TIMEOUT_MS=10000

# Docker Engine API, read-only (GET only - see src/lib/docker-socket.ts).
DOCKER_SOCKET_PATH=/var/run/docker.sock
# The container whose stdout carries Caddy's JSON access log.
CADDY_CONTAINER_NAME=portfolio-caddy-1

# Where the queue (undelivered samples) and small state files live.
COLLECTOR_STATE_DIR=/var/lib/vps-metrics-collector
COLLECTOR_QUEUE_MAX_LINES=1440
COLLECTOR_QUEUE_FLUSH_BUDGET_MS=15000

# Overrides os.hostname() in the emitted sample - usually left unset.
COLLECTOR_HOST_OVERRIDE=

# Skips the Azure send entirely (logs the sample to stdout instead) - the
# one way to run this locally without a real SAS token. Never set on the
# server unit.
DRY_RUN=false
