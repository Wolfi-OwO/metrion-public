# HTTP port the ingest service listens on.
PORT=8090
NODE_ENV=development
LOG_LEVEL=info

# Postgres/TimescaleDB connection string. Unset falls back to @metrion/db's
# own local-dev default (postgres://metrion:metrion@localhost:5432/metrion),
# matching docker-compose.dev.yml. Production always sets a real one.
DATABASE_URL=

# Ingest rate limit, applied per API key - never per IP, see
# docs/adr/0005-api-key-determines-tenancy.md.
INGEST_RATE_LIMIT_MAX=120
INGEST_RATE_LIMIT_WINDOW_MS=60000
