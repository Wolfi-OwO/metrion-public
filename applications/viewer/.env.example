# HTTP port the viewer listens on.
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Azure Blob Storage holding the day-blobs the collector writes.
# Read access uses DefaultAzureCredential (managed identity in Azure, `az login`
# locally) - NOT the collector's SAS token, which is add+create only and can
# neither read nor list.
AZURE_STORAGE_ACCOUNT=<storage-account-name>
# Still the old name on purpose: it holds real history and Azure cannot rename a
# container. See organizational/deployment-runbook.md.
AZURE_CONTAINER=vps-metrics

# Bearer token for POST /api/v1/ingest. Required - the viewer refuses to start
# without it. Generate with: openssl rand -hex 32
INGEST_TOKEN=

# Ingest rate limit, applied per token.
INGEST_RATE_LIMIT_MAX=120
INGEST_RATE_LIMIT_WINDOW_MS=60000

# Rate limit across the whole app, all callers together. This is what bounds
# the unauthenticated read API, which needs no token and fans out to up to 31
# blob reads per request.
GLOBAL_RATE_LIMIT_MAX=300
GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# Comma-separated browser origins allowed to call the API, e.g.
# https://mona.example.at. Unset means any origin - acceptable only because no
# endpoint here accepts a cookie or any browser-attached credential. Set it
# once the chart client has a real origin.
CORS_ALLOWED_ORIGINS=
